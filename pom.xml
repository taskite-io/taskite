<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.taskite</groupId>
  <artifactId>taskite-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Taskite Root</name>
  <description>Distributed job scheduling engine built for reliable execution at scale.</description>
  <url>https://taskite.io</url>
  <licenses>
    <license>
      <name>Taskite Community License 1.0</name>
      <url>https://github.com/taskite-io/taskite/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <modules>
    <module>util</module>
    <module>protocol</module>
    <module>scheduler</module>
    <module>snapshot</module>
    <module>cluster</module>
    <module>stream-platform</module>
    <module>db</module>
    <module>placement-driver-protocol</module>
    <module>placement-driver-client</module>
    <module>placement-driver</module>
    <module>broker-client</module>
    <module>engine</module>
    <module>broker</module>
    <module>gateway-protocol</module>
    <module>gateway</module>
    <module>webapp</module>
    <module>dist</module>
  </modules>
  <scm>
    <connection>scm:git:https://github.com/taskite-io/taskite.git</connection>
    <developerConnection>scm:git:git@github.com:taskite-io/taskite.git</developerConnection>
    <url>https://github.com/taskite-io/taskite</url>
  </scm>
  <properties>
    <agrona.version>1.21.1</agrona.version>
    <assertj.version>3.27.3</assertj.version>
    <concurrency-limits.version>0.5.4</concurrency-limits.version>
    <cron-utils.version>9.2.1</cron-utils.version>
    <grpc.version>1.68.1</grpc.version>
    <javax.annotation.version>1.3.2</javax.annotation.version>
    <jraft.version>1.4.1</jraft.version>
    <junit.version>5.11.4</junit.version>
    <logback.version>1.5.12</logback.version>
    <maven.compiler.release>21</maven.compiler.release>
    <msgpack.version>0.9.8</msgpack.version>
    <pekko.version>1.0.1</pekko.version>
    <plugin.version.build-helper>3.5.0</plugin.version.build-helper>
    <plugin.version.dependency>3.8.1</plugin.version.dependency>
    <plugin.version.exec>3.3.0</plugin.version.exec>
    <plugin.version.googlejavaformat>1.22.0</plugin.version.googlejavaformat>
    <plugin.version.license>5.1.0</plugin.version.license>
    <plugin.version.maven-compiler>3.13.0</plugin.version.maven-compiler>
    <plugin.version.maven-resources>3.3.1</plugin.version.maven-resources>
    <plugin.version.maven-shade>3.6.0</plugin.version.maven-shade>
    <plugin.version.maven-surefire>3.5.2</plugin.version.maven-surefire>
    <plugin.version.os-maven>1.7.1</plugin.version.os-maven>
    <plugin.version.protobuf>0.6.1</plugin.version.protobuf>
    <plugin.version.spotless>2.43.0</plugin.version.spotless>
    <plugin.version.third-party-license>2.7.1</plugin.version.third-party-license>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <protobuf.version>3.25.5</protobuf.version>
    <rocksdb.version>9.7.3</rocksdb.version>
    <sbe.version>1.31.1</sbe.version>
    <skipChecks>false</skipChecks>
    <slf4j.version>2.0.16</slf4j.version>
    <spring-boot.version>3.3.4</spring-boot.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.msgpack</groupId>
        <artifactId>jackson-dataformat-msgpack</artifactId>
        <version>${msgpack.version}</version>
      </dependency>
      <dependency>
        <groupId>com.cronutils</groupId>
        <artifactId>cron-utils</artifactId>
        <version>${cron-utils.version}</version>
      </dependency>
      <!-- Import JUnit first so Jupiter and Platform use the project version over Spring Boot. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
              Spring Boot BOM: manages the placement-driver's embedded-Tomcat admin HTTP stack
              (spring-boot-starter-web/-test) and their transitives. Imported (not a parent) so the rest
              of the multi-module build is unaffected. Direct <dependencyManagement> entries below still
              WIN over this import, so grpc/protobuf/logback stay pinned at the project's versions;
              Jackson is intentionally NOT pinned directly, so the BOM manages it (2.17.2) to avoid drift.
            -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>broker</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>broker-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>cluster</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>db</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>engine</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>gateway</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>gateway-protocol</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>placement-driver</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>placement-driver-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>placement-driver-protocol</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>protocol</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>scheduler</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>snapshot</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>stream-platform</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>util</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>webapp-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.taskite</groupId>
        <artifactId>webapp-server</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!--      <dependency>-->
      <!--        <groupId>io.taskite</groupId>-->
      <!--        <artifactId>taskite-distribution</artifactId>-->
      <!--        <version>${project.version}</version>-->
      <!--      </dependency>-->
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>com.netflix.concurrency-limits</groupId>
        <artifactId>concurrency-limits-core</artifactId>
        <version>${concurrency-limits.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-api</artifactId>
        <version>${grpc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-netty-shaded</artifactId>
        <version>${grpc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-protobuf</artifactId>
        <version>${grpc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-stub</artifactId>
        <version>${grpc.version}</version>
      </dependency>
      <dependency>
        <groupId>javax.annotation</groupId>
        <artifactId>javax.annotation-api</artifactId>
        <version>${javax.annotation.version}</version>
      </dependency>
      <dependency>
        <groupId>org.agrona</groupId>
        <artifactId>agrona</artifactId>
        <version>${agrona.version}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.pekko</groupId>
        <artifactId>pekko-actor-typed_2.13</artifactId>
        <version>${pekko.version}</version>
      </dependency>
      <dependency>
        <groupId>org.rocksdb</groupId>
        <artifactId>rocksdbjni</artifactId>
        <version>${rocksdb.version}</version>
      </dependency>
      <!--
              SOFAJRaft consensus engine (replacing the in-house io.taskite.cluster.raft.*).
              We depend on rpc-grpc-impl (jraft's gRPC transport) so raft rides gRPC rather than Bolt,
              matching the project's existing grpc-netty-shaded stack. jraft-parent pins protobuf 3.25.5
              (identical to this project), so protobuf does not conflict. grpc is excluded here and
              supplied by this project's own grpc-* management at ${grpc.version} (1.68.1) to keep a
              single grpc version across raft + business APIs.
            -->
      <dependency>
        <groupId>com.alipay.sofa</groupId>
        <artifactId>rpc-grpc-impl</artifactId>
        <version>${jraft.version}</version>
        <exclusions>
          <exclusion>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
          </exclusion>
          <exclusion>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
          </exclusion>
          <exclusion>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
          </exclusion>
          <exclusion>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-util</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>com.alipay.sofa</groupId>
        <artifactId>jraft-core</artifactId>
        <version>${jraft.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${plugin.version.maven-resources}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${plugin.version.maven-surefire}</version>
          <configuration>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${plugin.version.maven-compiler}</version>
          <configuration>
            <compilerReuseStrategy>alwaysNew</compilerReuseStrategy>
            <fork>true</fork>
            <useIncrementalCompilation>false</useIncrementalCompilation>
          </configuration>
        </plugin>

        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${plugin.version.spotless}</version>
          <dependencies>
            <dependency>
              <groupId>com.google.googlejavaformat</groupId>
              <artifactId>google-java-format</artifactId>
              <version>${plugin.version.googlejavaformat}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${plugin.version.exec}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${plugin.version.build-helper}</version>
        </plugin>
        <plugin>
          <groupId>org.xolstice.maven.plugins</groupId>
          <artifactId>protobuf-maven-plugin</artifactId>
          <version>${plugin.version.protobuf}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${plugin.version.maven-shade}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.mycila</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>${plugin.version.license}</version>
        <inherited>false</inherited>
        <configuration>
          <aggregate>true</aggregate>
          <skip>${skipChecks}</skip>
          <strictCheck>true</strictCheck>
          <failIfMissing>true</failIfMissing>
          <failIfUnknown>true</failIfUnknown>
          <mapping>
            <ts>SLASHSTAR_STYLE</ts>
            <tsx>SLASHSTAR_STYLE</tsx>
          </mapping>
          <licenseSets>
            <licenseSet>
              <header>${maven.multiModuleProjectDirectory}/licenses/license-header</header>
              <includes>
                <include>**/src/**/*.java</include>
                <include>webapp/client/src/**/*.ts</include>
                <include>webapp/client/src/**/*.tsx</include>
                <include>webapp/client/src/**/*.css</include>
                <include>webapp/client/*.ts</include>
                <include>webapp/client/e2e/**/*.ts</include>
              </includes>
              <excludes />
            </licenseSet>
          </licenseSets>
        </configuration>
        <executions>
          <execution>
            <id>format-license-headers</id>
            <goals>
              <goal>format</goal>
            </goals>
            <phase>initialize</phase>
          </execution>
          <execution>
            <id>check-license-headers</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>include-taskite-legal-files</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>process-resources</phase>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF/taskite</outputDirectory>
              <resources>
                <resource>
                  <directory>${maven.multiModuleProjectDirectory}</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>LICENSE</include>
                    <include>NOTICE.txt</include>
                    <include>THIRD_PARTY_NOTICES.md</include>
                    <include>COMMERCIAL-LICENSING.md</include>
                    <include>CLA.md</include>
                    <include>licenses/Clarification-on-gRPC-code-generation.txt</include>
                    <include>licenses/license-header</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${plugin.version.googlejavaformat}</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
          </java>
          <markdown>
            <includes>
              <include>**/*.md</include>
            </includes>
            <excludes>
              <exclude>**/target/**/*.md</exclude>
              <exclude>**/node_modules/**/*.md</exclude>
            </excludes>
            <flexmark />
          </markdown>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
              <spaceBeforeCloseEmptyElement>true</spaceBeforeCloseEmptyElement>
              <sortProperties>true</sortProperties>
            </sortPom>
          </pom>
          <applySkip>${skipChecks}</applySkip>
          <checkSkip>${skipChecks}</checkSkip>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>apply</goal>
            </goals>
            <phase>process-sources</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <outputDirectory>${project.build.directory}/maven-classes</outputDirectory>
    <testOutputDirectory>${project.build.directory}/maven-test-classes</testOutputDirectory>
  </build>
</project>
