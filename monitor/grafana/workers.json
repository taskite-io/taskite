      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "taskite_pd_worker_active_jobs{cluster=~\"$cluster\",tenant=~\"$tenant\",name=~\"$workerName\"} and on(pd_node) (taskite_pd_raft_role == 3)",
          "legendFormat": "{{cluster}} / {{tenant}} / {{name}} / {{worker_id}} active",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "taskite_pd_worker_max_jobs_active{cluster=~\"$cluster\",tenant=~\"$tenant\",name=~\"$workerName\"} and on(pd_node) (taskite_pd_raft_role == 3)",
          "legendFormat": "{{cluster}} / {{tenant}} / {{name}} / {{worker_id}} max",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Active Jobs and Capacity",
      "type": "timeseries"
    }
