        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count(taskite_pd_worker_status{cluster=~\"$cluster\",tenant=~\"$tenant\",name=~\"$workerName\"} and on(pd_node) (taskite_pd_raft_role == 3)) - sum(taskite_pd_worker_status{cluster=~\"$cluster\",tenant=~\"$tenant\",name=~\"$workerName\"} and on(pd_node) (taskite_pd_raft_role == 3))",
          "instant": true,
          "legendFormat": "Offline",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Offline Workers",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(taskite_pd_worker_active_jobs{cluster=~\"$cluster\",tenant=~\"$tenant\",name=~\"$workerName\"} and on(pd_node) (taskite_pd_raft_role == 3))",
          "legendFormat": "Active jobs",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Active Jobs",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 10,
        "minVizWidth": 0,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(taskite_pd_worker_active_jobs{cluster=~\"$cluster\",tenant=~\"$tenant\",name=~\"$workerName\"} and on(pd_node) (taskite_pd_raft_role == 3)) / clamp_min(sum(taskite_pd_worker_max_jobs_active{cluster=~\"$cluster\",tenant=~\"$tenant\",name=~\"$workerName\"} and on(pd_node) (taskite_pd_raft_role == 3)), 1)",
          "instant": true,
          "legendFormat": "Utilization",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Worker Capacity Utilization",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "OFFLINE": {
                        "color": "red",
                        "index": 1,
                        "text": "OFFLINE"
                      },
                      "ONLINE": {
                        "color": "green",
                        "index": 0,
                        "text": "ONLINE"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last renewal"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (pd_node, cluster, tenant, name, worker_id, job_type, client_version, status) (taskite_pd_worker_last_renewal_at_seconds{cluster=~\"$cluster\",tenant=~\"$tenant\",name=~\"$workerName\"} and on(pd_node) (taskite_pd_raft_role == 3)) * 1000",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Registered Workers",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "pd_node": true
            },
            "indexByName": {
              "cluster": 0,
              "tenant": 1,
              "name": 2,
              "worker_id": 3,
              "job_type": 4,
              "client_version": 5,
              "status": 6,
              "Value": 7
            },
            "renameByName": {
              "Value": "last renewal",
              "client_version": "client version",
              "job_type": "job type",
              "worker_id": "worker id"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
