<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<sbe:messageSchema
        xmlns:sbe="http://fixprotocol.io/2016/sbe"
        xmlns:xi="http://www.w3.org/2001/XInclude"
        package="io.taskite.protocol.record"
        id="900"
        version="16"
        semanticVersion="${project.version}"
        byteOrder="littleEndian">

    <types>
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>

        <composite name="groupSizeEncoding" description="Repeating group dimensions">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>

        <composite name="varDataEncoding">
            <type name="length" primitiveType="uint32" maxValue="2147483647"/>
            <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
        </composite>

        <enum name="errorCode" encodingType="uint8" semanticType="String" description="The error code of an error">
            <validValue name="INTERNAL_ERROR">0</validValue>
            <validValue name="PARTITION_LEADER_MISMATCH">1</validValue>
            <validValue name="RESOURCE_EXHAUSTED">2</validValue>
        </enum>

        <enum name="RecordType" encodingType="uint8">
            <validValue name="EVENT">0</validValue>
            <validValue name="COMMAND">1</validValue>
            <validValue name="COMMAND_REJECTION">2</validValue>
        </enum>

        <enum name="ValueType" encodingType="uint8" description="The type of a record value">
            <validValue name="TOPOLOGY">0</validValue>
            <validValue name="BROKER_REGISTRATION">1</validValue>
            <validValue name="MEMBER_CHANGE">2</validValue>
            <validValue name="PARTITION_CHANGE">3</validValue>
            <validValue name="BROKER_PARTITION_CONFIGURATION">4</validValue>
            <validValue name="BROKER_PARTITION_OPERATION">5</validValue>
            <validValue name="COMMAND_DISTRIBUTION">6</validValue>
            <validValue name="JOB_SUBSCRIPTION">7</validValue>
            <validValue name="JOB_SUBSCRIPTION_DELETION">8</validValue>
            <validValue name="JOB_SUBSCRIPTION_MIRROR">9</validValue>
            <validValue name="WORKER_REGISTRATION">10</validValue>
            <validValue name="JOB">11</validValue>
            <validValue name="JOB_BATCH">12</validValue>
            <validValue name="JOB_YIELD">13</validValue>
            <validValue name="INCIDENT">14</validValue>
            <validValue name="VARIABLE">15</validValue>
            <validValue name="VARIABLE_DOCUMENT">16</validValue>
            <validValue name="TIMER">17</validValue>
        </enum>

        <enum name="RejectionType" encodingType="uint8">
            <validValue name="INVALID_ARGUMENT">0</validValue>
            <validValue name="NOT_FOUND">1</validValue>
            <validValue name="ALREADY_EXISTS">2</validValue>
            <validValue name="INVALID_STATE">3</validValue>
            <validValue name="PROCESSING_ERROR">4</validValue>
            <validValue name="EXCEEDED_BATCH_RECORD_SIZE">5</validValue>
            <validValue name="STALE_WORKER_SESSION">6</validValue>
            <validValue name="FEATURE_DISABLED">7</validValue>
            <validValue name="WORKER_SESSION_NOT_READY">8</validValue>
        </enum>

        <enum name="TopologyOperationType" encodingType="uint8">
            <validValue name="ADD">0</validValue>
            <validValue name="JOIN">1</validValue>
            <validValue name="PROMOTE_LEARNER">2</validValue>
            <validValue name="LEAVE">3</validValue>
            <validValue name="RECONFIGURE_PRIORITY">4</validValue>
            <validValue name="TRANSFER_LEADER">5</validValue>
            <validValue name="STEP_DOWN_IF_NOT_PRIMARY">6</validValue>
            <validValue name="RESET_PEERS">7</validValue>
        </enum>

        <enum name="BrokerPartitionChangePurpose" encodingType="uint8">
            <validValue name="MIGRATION">0</validValue>
            <validValue name="BOOTSTRAP">1</validValue>
        </enum>

        <enum name="BrokerPartitionChangeStatus" encodingType="uint8">
            <validValue name="PENDING">0</validValue>
            <validValue name="IN_PROGRESS">1</validValue>
            <validValue name="WAITING_READY">2</validValue>
            <validValue name="WAITING_LEADER_CONVERGE">3</validValue>
            <validValue name="COMPLETED">4</validValue>
            <validValue name="FAILED">5</validValue>
            <validValue name="SUPERSEDING">6</validValue>
            <validValue name="SUPERSEDED">7</validValue>
            <validValue name="QUEUED">8</validValue>
        </enum>

        <enum name="TopologyOperationStatus" encodingType="uint8">
            <validValue name="NONE">0</validValue>
            <validValue name="IN_PROGRESS">1</validValue>
            <validValue name="APPLIED">2</validValue>
            <validValue name="FAILED">3</validValue>
        </enum>

    </types>


    <sbe:message name="ErrorResponse" id="10" description="Standard error response">
        <field name="errorCode" id="1" type="errorCode"/>
        <data name="errorMessage" id="2" type="varDataEncoding"/>
    </sbe:message>

    <sbe:message name="ExecuteCommandRequest" id="20">
        <field name="partitionId" id="1" type="uint16"/>
        <field name="key" id="4" type="uint64"/>
        <field name="valueType" id="5" type="ValueType"/>
        <field name="intent" id="6" type="uint8"/>
        <data name="value" id="7" type="varDataEncoding"/>
        <data name="clusterId" id="8" type="varDataEncoding" sinceVersion="8"/>
    </sbe:message>

    <sbe:message name="ExecuteCommandResponse" id="21">
        <field name="partitionId" id="1" type="uint16"/>
        <field name="key" id="2" type="uint64"/>
        <field name="recordType" id="3" type="RecordType"/>
        <field name="valueType" id="4" type="ValueType"/>
        <field name="intent" id="5" type="uint8"/>
        <!-- populated when RecordType is COMMAND_REJECTION -->
        <field name="rejectionType" id="6" type="RejectionType"/>
        <!-- populated when RecordType is COMMAND_REJECTION, UTF-8-encoded String -->
        <data name="rejectionReason" id="7" type="varDataEncoding"/>
        <data name="value" id="8" type="varDataEncoding"/>
    </sbe:message>


    <sbe:message name="ExecuteAdminRequest" id="22" sinceVersion="13">
        <field name="partitionId" id="1" type="int32"/>
        <field name="valueType" id="2" type="ValueType"/>
        <field name="intent" id="3" type="uint8"/>
        <data name="clusterId" id="4" type="varDataEncoding"/>
        <data name="value" id="5" type="varDataEncoding"/>
    </sbe:message>

    <sbe:message name="ExecuteAdminResponse" id="23" sinceVersion="13">
        <field name="partitionId" id="1" type="int32"/>
        <field name="valueType" id="2" type="ValueType"/>
        <field name="intent" id="3" type="uint8"/>
        <field name="recordType" id="4" type="RecordType"/>
        <field name="rejectionType" id="5" type="RejectionType"/>
        <data name="clusterId" id="6" type="varDataEncoding"/>
        <data name="rejectionReason" id="7" type="varDataEncoding"/>
        <data name="value" id="8" type="varDataEncoding"/>
    </sbe:message>

    <sbe:message name="BrokerRegistrationRequest" id="304">
        <field name="port" id="1" type="int32"/>
        <field name="renewalTimeoutMillis" id="17" type="int64"/>
        <field name="expectedLastRenewalEpochMillis" id="18" type="int64"/>
        <field name="eventTimestampEpochMillis" id="22" type="int64" sinceVersion="7"/>
        <field name="raftPort" id="23" type="int32" sinceVersion="9"/>
        <field name="preservePartitionObservations" id="33" type="uint8" sinceVersion="10"/>
        <group name="partitions" id="2" dimensionType="groupSizeEncoding">
            <field name="partitionId" id="3" type="int32"/>
