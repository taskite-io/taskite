    <!-- PD-internal persisted partition topology (the placement source of truth). Kept off the
         client/broker wire in Phase 1: the round-robin assignment is materialized deterministically
         by the appliers and read back here, so the PD survives restart by replay rather than
         recomputation. -->
    <sbe:message name="PartitionTopologyRecord" id="323">
        <field name="partitionId" id="1" type="int32"/>
        <field name="replicationFactor" id="2" type="int32"/>
        <field name="recoveryEpoch" id="26" type="int64" sinceVersion="5"/>
        <field name="initializing" id="40" type="uint8" sinceVersion="14"/>
        <group name="desiredVoters" id="3" dimensionType="groupSizeEncoding">
            <data name="brokerId" id="4" type="varDataEncoding"/>
        </group>
        <group name="currentVoters" id="5" dimensionType="groupSizeEncoding">
            <data name="brokerId" id="6" type="varDataEncoding"/>
        </group>
        <group name="learners" id="7" dimensionType="groupSizeEncoding">
            <data name="brokerId" id="8" type="varDataEncoding"/>
        </group>
        <group name="priorities" id="12" dimensionType="groupSizeEncoding" sinceVersion="3">
            <field name="priority" id="13" type="int32"/>
            <data name="brokerId" id="14" type="varDataEncoding"/>
        </group>
        <group name="replicaStates" id="15" dimensionType="groupSizeEncoding" sinceVersion="3">
            <field name="matchIndex" id="16" type="int64"/>
            <field name="lag" id="17" type="int64"/>
            <field name="lastReportTimeEpochMillis" id="18" type="int64"/>
            <field name="readyForPromotion" id="19" type="uint8"/>
            <field name="priority" id="20" type="int32"/>
            <field name="configurationIndex" id="31" type="int64" sinceVersion="10"/>
            <field name="desiredPriority" id="32" type="int32" sinceVersion="10"/>
            <field name="targetPriority" id="33" type="int32" sinceVersion="10"/>
            <field name="serviceReady" id="34" type="uint8" sinceVersion="10"/>
            <field name="observedAtEpochMillis" id="35" type="int64" sinceVersion="10"/>
            <field name="replicaRecoveryEpoch" id="36" type="int64" sinceVersion="10"/>
            <data name="brokerId" id="21" type="varDataEncoding"/>
            <data name="role" id="22" type="varDataEncoding"/>
            <data name="lifecycleState" id="23" type="varDataEncoding"/>
            <data name="lastOpId" id="24" type="varDataEncoding"/>
            <data name="lastOpStatus" id="25" type="varDataEncoding"/>
            <data name="configurationDigest" id="37" type="varDataEncoding" sinceVersion="10"/>
            <data name="nodeState" id="38" type="varDataEncoding" sinceVersion="10"/>
            <data name="leaderId" id="39" type="varDataEncoding" sinceVersion="10"/>
