            <field name="priority" id="13" type="int32" sinceVersion="3"/>
            <field name="recoveryEpoch" id="21" type="int64" sinceVersion="5"/>
            <field name="configurationIndex" id="24" type="int64" sinceVersion="10"/>
            <field name="desiredPriority" id="25" type="int32" sinceVersion="10"/>
            <field name="targetPriority" id="26" type="int32" sinceVersion="10"/>
            <field name="serviceReady" id="27" type="uint8" sinceVersion="10"/>
            <field name="observedAtEpochMillis" id="28" type="int64" sinceVersion="10"/>
            <data name="role" id="5" type="varDataEncoding"/>
            <data name="lifecycleState" id="14" type="varDataEncoding" sinceVersion="3"/>
            <data name="lastOpId" id="15" type="varDataEncoding" sinceVersion="3"/>
            <data name="lastOpStatus" id="16" type="varDataEncoding" sinceVersion="3"/>
            <data name="configurationDigest" id="29" type="varDataEncoding" sinceVersion="10"/>
            <data name="nodeState" id="30" type="varDataEncoding" sinceVersion="10"/>
            <data name="leaderId" id="31" type="varDataEncoding" sinceVersion="10"/>
        </group>
        <data name="clusterId" id="6" type="varDataEncoding"/>
        <data name="brokerId" id="7" type="varDataEncoding"/>
        <data name="host" id="8" type="varDataEncoding"/>
        <data name="version" id="9" type="varDataEncoding"/>
        <data name="incarnationId" id="32" type="varDataEncoding" sinceVersion="10"/>
    </sbe:message>

    <sbe:message name="ClusterTopologyRecord" id="321">
        <field name="clusterSize" id="1" type="int32"/>
