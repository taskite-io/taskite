        <data name="clusterId" id="9" type="varDataEncoding"/>
        <data name="status" id="10" type="varDataEncoding"/>
        <data name="desiredPrimary" id="11" type="varDataEncoding"/>
        <data name="recoveryPhase" id="29" type="varDataEncoding" sinceVersion="5"/>
        <data name="survivorBrokerId" id="30" type="varDataEncoding" sinceVersion="5"/>
    </sbe:message>

