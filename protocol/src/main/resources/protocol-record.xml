        <data name="opId" id="4" type="varDataEncoding"/>
        <data name="errorMessage" id="5" type="varDataEncoding"/>
        <data name="configurationDigest" id="8" type="varDataEncoding" sinceVersion="10"/>
    </sbe:message>
</sbe:messageSchema>
