<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.taskite</groupId>
    <artifactId>taskite-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>taskite-distribution</artifactId>
  <name>Taskite Distribution</name>
  <properties>
    <taskite.distribution.finalName>${project.artifactId}-${project.version}</taskite.distribution.finalName>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.taskite</groupId>
      <artifactId>gateway</artifactId>
    </dependency>
    <dependency>
      <groupId>io.taskite</groupId>
      <artifactId>broker</artifactId>
    </dependency>
    <dependency>
      <groupId>io.taskite</groupId>
      <artifactId>placement-driver</artifactId>
    </dependency>
    <dependency>
      <groupId>io.taskite</groupId>
      <artifactId>webapp-server</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>${taskite.distribution.finalName}</finalName>
    <resources>
      <resource>
        <filtering>false</filtering>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>banner.txt</exclude>
        </excludes>
      </resource>
      <resource>
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
        <includes>
          <include>banner.txt</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>${plugin.version.third-party-license}</version>
        <executions>
          <execution>
            <id>generate-third-party-inventory</id>
            <goals>
              <goal>add-third-party</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <bundleThirdPartyPath>META-INF/taskite/third-party/THIRD-PARTY.txt</bundleThirdPartyPath>
              <excludedGroups>io\.taskite</excludedGroups>
              <excludedScopes>test,provided,system</excludedScopes>
              <failOnMissing>true</failOnMissing>
              <force>true</force>
              <generateBundle>true</generateBundle>
              <includeTransitiveDependencies>true</includeTransitiveDependencies>
              <outputDirectory>${project.build.directory}/generated-resources/license</outputDirectory>
              <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${plugin.version.dependency}</version>
        <executions>
          <execution>
            <id>extract-third-party-legal-files</id>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <phase>prepare-package</phase>
            <configuration>
              <excludeGroupIds>io.taskite</excludeGroupIds>
              <includeScope>runtime</includeScope>
              <includes>LICENSE,LICENSE.*,NOTICE,NOTICE.*,META-INF/LICENSE*,META-INF/NOTICE*,META-INF/DISCLAIMER*</includes>
              <outputDirectory>${project.build.outputDirectory}/META-INF/taskite/third-party/artifacts</outputDirectory>
              <overWriteIfNewer>true</overWriteIfNewer>
              <useSubDirectoryPerArtifact>true</useSubDirectoryPerArtifact>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <!--
            Shade replaces the main artifact with the fat JAR. Force the thin project JAR to be
            rebuilt on every package so a later incremental package cannot feed that old fat JAR
            back into shade and let stale project/dependency classes win duplicate resolution.
          -->
          <forceCreation>true</forceCreation>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <configuration>
          <useDefaultDelimiters>false</useDefaultDelimiters>
          <delimiters>
            <delimiter>@</delimiter>
          </delimiters>
        </configuration>
        <executions>
          <execution>
            <id>copy-distribution-config</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>process-resources</phase>
            <configuration>
              <outputDirectory>${project.build.directory}/config</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/config</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-canonical-third-party-licenses</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>process-resources</phase>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF/taskite/third-party/canonical</outputDirectory>
              <resources>
                <resource>
                  <directory>${maven.multiModuleProjectDirectory}/licenses/third-party</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <dependencies>
          <!--
            Supplies PropertiesMergingResourceTransformer so the two overlapping
            META-INF/spring.factories files (spring-boot + spring-boot-autoconfigure) are merged
            per-key instead of one clobbering the other. Without this, Spring Boot loses key
            listeners/initializers and fails to start from the shaded uber-jar.
          -->
          <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <version>${spring-boot.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <!--
                Strip signature files from signed dependencies. When their .SF/.DSA/.RSA entries
                survive into the shaded uber-jar, the JVM verifies them against the shade-merged
                manifest and fails with "Invalid signature file digest for Manifest main
                attributes", intermittently preventing the main class from loading.
              -->
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>LICENSE</exclude>
                    <exclude>LICENSE.*</exclude>
                    <exclude>META-INF/LICENSE</exclude>
                    <exclude>META-INF/LICENSE.*</exclude>
                    <exclude>META-INF/license.*</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                  <addHeader>false</addHeader>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>META-INF/LICENSE</resource>
                  <file>${maven.multiModuleProjectDirectory}/LICENSE</file>
                </transformer>
                <transformer implementation="org.springframework.boot.maven.PropertiesMergingResourceTransformer">
                  <resource>META-INF/spring.factories</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>reference.conf</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.taskite.dist.TaskiteDistribution</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
